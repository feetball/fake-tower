{
  "name": "fake-tower",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fake Tower - a realistic multiplayer ATC social deduction game. Two voices claim to be the tower. One is lying.",
  "scripts": {
    "dev": "concurrently -k -n server,client \"tsx watch src/server/main.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx src/server/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node e2e/smoke.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "tsx": "^4.19.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "@vitest/coverage-v8": "^5.1.1",
    "concurrently": "^9.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.74.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
