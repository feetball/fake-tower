; Engine configuration file.
config_version=5

[application]

config/name="Fake Tower"
config/description="Two voices claim to be the tower. One is lying."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")

[audio]

driver/enable_input=true

[autoload]

Session="*res://core/session.gd"
Voice="*res://voice/voice.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_taa=false
environment/defaults/default_clear_color=Color(0.01, 0.012, 0.016, 1)
